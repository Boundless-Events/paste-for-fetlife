{
  "manifest_version": 3,
  "name": "Paste for FetLife",
  "version": "1.0.1",
  "description": "Clean up formatting when you paste from Google Docs, Word, websites or your CMS into FetLife's event and writing editors.",
  "homepage_url": "https://github.com/Boundless-Events/paste-for-fetlife",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fetlife.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
